# frozen_string_literal: true

source "https://rubygems.org"

gem "activerecord-jdbcsqlite3-adapter"
gem "jdbc-sqlite3"

# Pin to 7.0.x because Rails 7.1+ uses Time.new(string, in:) in fast_string_to_time,
# which JRuby doesn't fully support yet (https://github.com/jruby/jruby/issues/8736).
gem "rails", "~> 7.0.0"
gem "sequel", "~> 5.0"

gemspec path: ".."
